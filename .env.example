# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the URL the TV's QR code points to. Defaults to the TV page's own origin.
# Set this if the TV is showing a localhost/dev URL that phones can't reach.
VITE_PUBLIC_URL=
